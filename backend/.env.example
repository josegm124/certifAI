PORT=3001
LOG_LEVEL=info
NODE_ENV=development

# Database reset mode (development only)
# true = Auto-reset DB + uploads on every start (only for disposable test data)
# false = Keep data between restarts
RESET_DB_ON_START=false

# Required in production. Use a long random value and never expose it to Vite.
JWT_SECRET=replace-with-a-long-random-secret
